        <!-- ===================== TITLE ===================== -->
        <mxCell id="title-text" style="text;html=1;resizable=1;points=[];align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" value="ACI Capstone 1 - Serverless License Onboarding Platform" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" style="text;html=1;resizable=1;points=[];align=left;verticalAlign=top;spacingTop=-4;fontSize=15;fontFamily=Helvetica;whiteSpace=wrap;" value="A Cognito-authenticated Next.js SPA served over HTTPS by CloudFront from a private S3 bucket (OAC) asks the app API for a presigned URL and uploads an applicant zip straight to the document bucket. S3 to EventBridge starts a Step Functions execution that unzips, persists and validates the applicant (Rekognition + Textract), then hands off through SQS to a submit Lambda that calls the validation API - while the browser polls the same API for the verdict." vertex="1" parent="1">          <mxGeometry x="122" y="84" width="1900" height="46" as="geometry" />
        </mxCell>
        <mxCell id="title-separator" style="line;strokeWidth=2;html=1;strokeColor=#FF9900;fontFamily=Helvetica;" value="" vertex="1" parent="1">
          <mxGeometry x="120" y="136" width="1900" height="10" as="geometry" />
        </mxCell>

