        <mxCell id="svc-monolith" style="sketch=0;outlineConnect=0;fontColor=#8C8C8C;fillColor=#BFBFBF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;whiteSpace=wrap;labelWidth=150;" value="AWS Lambda&lt;br&gt;&lt;i&gt;DocumentLambda (commented out)&lt;/i&gt;" vertex="1" parent="grp-monolith">
          <mxGeometry x="61" y="24" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="aux-note" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;fontFamily=Helvetica;whiteSpace=wrap;labelBackgroundColor=none;" value="CloudWatch keeps 14-day retention on all eight Lambda log groups: the seven deployed functions plus the removed monolith's, which is still declared.&lt;br&gt;&lt;br&gt;X-Ray is active on DocumentStateMachine and on WriteToDynamoLambda, which adds the Powertools layer for S3 / DynamoDB subsegments. Both need xray:* on their own IAM role or they emit nothing, silently.&lt;br&gt;&lt;br&gt;DocumentLambda is commented out entirely and no longer deployed; the Step Functions pipeline replaced it. Its role, policies and log group remain." vertex="1" parent="1">
          <mxGeometry x="1050" y="1445" width="440" height="130" as="geometry" />
        </mxCell>

        <!-- ===================== OPTIONAL / NOT IMPLEMENTED : CUSTOM DOMAIN ===================== -->
        <mxCell id="opt-box" style="rounded=0;fillColor=light-dark(#F7F7F7,#2B2B2B);strokeColor=#7D8998;dashed=1;dashPattern=8 6;strokeWidth=2;container=0;collapsible=0;pointerEvents=0;" value="" vertex="1" parent="1">
          <mxGeometry x="390" y="1680" width="1720" height="235" as="geometry" />
        </mxCell>
        <mxCell id="opt-title" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#7D8998;fontFamily=Helvetica;whiteSpace=wrap;labelBackgroundColor=none;" value="NOT IMPLEMENTED · optional - serve the site from a custom domain" vertex="1" parent="1">
          <mxGeometry x="412" y="1686" width="520" height="22" as="geometry" />
        </mxCell>
        <mxCell id="grp-r53" style="fillColor=#F2F2F2;strokeColor=#999999;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#999999;fontFamily=Helvetica;container=1;collapsible=0;dashed=1;strokeWidth=1.5;" value="Networking" vertex="1" parent="1">
          <mxGeometry x="420" y="1720" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="svc-r53" style="sketch=0;outlineConnect=0;fontColor=#8C8C8C;fillColor=#BFBFBF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;fontFamily=Helvetica;whiteSpace=wrap;labelWidth=150;opacity=60;" value="Amazon Route 53&lt;br&gt;&lt;i&gt;hosted zone · A alias to the distribution&lt;/i&gt;" vertex="1" parent="grp-r53">
          <mxGeometry x="61" y="24" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="grp-acm" style="fillColor=#F2F2F2;strokeColor=#999999;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#999999;fontFamily=Helvetica;container=1;collapsible=0;dashed=1;strokeWidth=1.5;" value="Security" vertex="1" parent="1">
          <mxGeometry x="720" y="1720" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="svc-acm" style="sketch=0;outlineConnect=0;fontColor=#8C8C8C;fillColor=#BFBFBF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;fontFamily=Helvetica;whiteSpace=wrap;labelWidth=150;opacity=60;" value="AWS Certificate Manager&lt;br&gt;&lt;i&gt;public cert · must be us-east-1&lt;/i&gt;" vertex="1" parent="grp-acm">
          <mxGeometry x="61" y="24" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="e-r53-acm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=1.5;strokeColor=#999999;" edge="1" parent="1" source="grp-r53" target="grp-acm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-dnsval" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#8C8C8C;labelBackgroundColor=none;whiteSpace=wrap;" value="DNS validation CNAME" vertex="1" parent="1">
          <mxGeometry x="602" y="1740" width="106" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lbl-opt-note" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=light-dark(#4D4D4D,#CCCCCC);labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;b&gt;Everything else on this diagram is deployed.&lt;/b&gt; The site is live on the distribution's default name, &lt;i&gt;https://d2u76q44gd8vxi.cloudfront.net&lt;/i&gt;, using the free *.cloudfront.net certificate. Serving it from your own URL needs a domain you own plus exactly these two services - and three edits to code that already exists.&lt;br&gt;&lt;br&gt;&lt;b&gt;Route 53&lt;/b&gt; - a public hosted zone for the domain (or NS delegation to it from an outside registrar), an A/AAAA &lt;i&gt;alias&lt;/i&gt; record pointing at the distribution, and the CNAME that validates the certificate. Alias is the only record type that can point an apex at CloudFront, and Route 53 does not bill alias queries to a distribution.&lt;br&gt;&lt;b&gt;AWS Certificate Manager&lt;/b&gt; - a public certificate covering the name, issued &lt;i&gt;in us-east-1&lt;/i&gt;. CloudFront reads certificates from that Region only and a certificate cannot be copied between Regions. This stack already deploys to us-east-1, so no second provider alias is needed.&lt;br&gt;&lt;br&gt;&lt;b&gt;The three edits:&lt;/b&gt; (1) add &lt;i&gt;aliases = [&quot;app.example.com&quot;]&lt;/i&gt; to aws_cloudfront_distribution.cdn; (2) swap &lt;i&gt;viewer_certificate&lt;/i&gt; from cloudfront_default_certificate = true to acm_certificate_arn + ssl_support_method = &quot;sni-only&quot;; (3) &lt;b&gt;add the new origin to both CORS allow-lists&lt;/b&gt; - envs/dev/main.tf builds &lt;i&gt;local.site_origin&lt;/i&gt; from the CloudFront URL and feeds it to api_cors_allow_origins &lt;i&gt;and&lt;/i&gt; document_bucket_cors_allow_origins. The browser's Origin header becomes the custom domain, so skipping this fails the presigned PUT and every /api/* call at preflight. Cognito needs no change: the SPA calls the Cognito API directly and has no hosted-UI callback list." vertex="1" parent="1">
          <mxGeometry x="950" y="1706" width="1140" height="196" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES : BROWSER PLANE ===================== -->

