    <mxGraphModel dx="2400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2950" pageHeight="2050" math="0" shadow="0">
