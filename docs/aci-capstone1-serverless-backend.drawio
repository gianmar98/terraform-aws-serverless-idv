        <mxCell id="grp-monolith" style="fillColor=#F2F2F2;strokeColor=#999999;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#999999;fontFamily=Helvetica;container=1;collapsible=0;dashed=1;strokeWidth=1.5;" value="Compute (removed)" vertex="1" parent="1">
          <mxGeometry x="840" y="1445" width="170" height="130" as="geometry" />
