        <!-- CompareFaces -> DynamoDB -->
        <mxCell id="e-cf-dynamo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.54;entryDx=0;entryDy=0;strokeWidth=1.5;" edge="1" parent="1" source="grp-cf" target="grp-dynamo">
